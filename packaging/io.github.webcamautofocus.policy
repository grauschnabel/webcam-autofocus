<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>webcam-autofocus</vendor>
  <vendor_url>https://github.com/grauschnabel/webcam-autofocus</vendor_url>
  <action id="io.github.webcamautofocus.create-virtual-camera">
    <description>Create a virtual camera for webcam-autofocus</description>
    <message>Authentication is required to create a virtual camera</message>
    <defaults>
      <!-- Logged-in users at the machine need no password; remote or inactive sessions are denied. -->
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/webcam-autofocus/create-virtual-camera</annotate>
  </action>
</policyconfig>
